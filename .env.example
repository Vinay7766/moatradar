# Copy to .env and fill in at least one LLM provider API key
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional explicit default provider/model (leave blank to choose dynamically in UI)
DEFAULT_LLM_PROVIDER=
DEFAULT_LLM_MODEL=

# Backend & Storage paths
SQLITE_DB_PATH=./data/cmi_desk.db
CHROMA_PERSIST_DIR=./data/chroma
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
